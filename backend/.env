# ================= 超市商品多模态检索系统 - 环境变量配置 =================
# 复制本文件为 .env 并按实际环境修改

# ---------- 应用配置 ----------
DEBUG=true
API_PREFIX=/api

# ---------- 轻量模式（无中间件一键启动） ----------
LIGHTWEIGHT=true
SQLITE_PATH=./data/goods_search.db
LOCAL_STORAGE_DIR=./data/storage

# ---------- MySQL 配置 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=goods_search

# ---------- Redis 配置 ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- Celery 配置 ----------
CELERY_BROKER=redis://127.0.0.1:6379/1
CELERY_BACKEND=redis://127.0.0.1:6379/2

# ---------- MinIO 对象存储 ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=goods-images
MINIO_SECURE=false

# ---------- Milvus 向量库 ----------
# Milvus-Lite 本地模式，使用本地文件存储
MILVUS_URI=./data/milvus_lite.db
MILVUS_COLLECTION_IMAGE=image_vectors
MILVUS_COLLECTION_TEXT=text_vectors
MILVUS_DIM=512
MILVUS_TEXT_DIM=512

# ---------- 模型配置 ----------
CLIP_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
MODEL_DEVICE=cpu

# ---------- 检索参数 ----------
SEARCH_TOP_N=10
SEARCH_THRESHOLD=0.5
HYBRID_IMAGE_WEIGHT=0.6
HYBRID_TEXT_WEIGHT=0.4

# ---------- 鉴权配置 ----------
JWT_SECRET_KEY=goods-search-secret-key-please-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
